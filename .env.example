# Zkopíruj do .env.local pro lokální vývoj; na Vercelu nastav v Project Settings.
NEXT_PUBLIC_SITE_URL=https://se-vezmou.cz

# Adresa průvodce (`app.`): sem vedou tlačítka „Vytvořit web“ a pole jmen z úvodní stránky.
# Lokálně např. http://app.localhost:3000. Hodnota se vkládá při sestavení a je i ve `form-action` CSP.
NEXT_PUBLIC_APP_URL=https://app.se-vezmou.cz

# Směrování podle hostitele (docs/adr/0002). Kořenová doména, pod kterou běží app., admin.
# a weby párů. Lokálně `localhost` (běží `localhost:3000`, `app.localhost:3000`,
# `admin.localhost:3000`, `klara-a-matej.localhost:3000`). Na Vercelu v produkci `se-vezmou.cz`
# (výchozí hodnota, když proměnná chybí).
ROOT_DOMAIN=localhost

# Jen pro náhledy nasazení na `*.vercel.app`, které nemají subdomény. Produkce (`VERCEL_ENV=production`)
# tyto proměnné nikdy nečte. HOST_PRESET: marketing | app | admin | tenant.
# HOST_PRESET=marketing
# PREVIEW_TENANT_SLUG=klara-a-matej

# Vizuální katalog UI primitiv na `/ui-catalog`: ve vývoji zapnutý vždy; v produkčním sestavení
# jen s touto proměnnou (a nikdy při VERCEL_ENV=production). Používá ho test přístupnosti.
# ENABLE_UI_CATALOG=1

# Databáze (docs/adr/0011): sdílený projekt Supabase, aplikace používá VÝHRADNĚ schéma `se_vezmou` a mluví s
# Postgresem přímo přes `pg` (žádný PostgREST, supabase-js, anon ani service role klíč, žádné NEXT_PUBLIC_SUPABASE_*).
# DATABASE_URL: pooler Supabase v transaction módu (port 6543) pro roli se_vezmou_app, jen serverová proměnná na
# Vercelu, např. postgresql://se_vezmou_app.<ref>:<heslo>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Lokálně adresa vlastního PostgreSQL s migracemi (role se_vezmou_app, viz supabase/README.md).
DATABASE_URL=
# Volitelně PEM kořenové CA Supabase: zapne ověřování certifikátu databáze (jinak TLS bez ověření řetězu).
# DATABASE_CA_CERT=
# Záložní zdroj adresy: SUPABASE_URL se použije jen pokud začíná postgres:// nebo postgresql://.
# SUPABASE_URL=

# Nasazení migrací (jen pro `npm run db:migrate` na počítači majitele, NIKDY na Vercel ani do repozitáře):
# spojení vlastníka (role postgres), přímé nebo session pooler (port 5432), ne role se_vezmou_app.
# MIGRATE_DATABASE_URL=

# Přihlášení (M4). Tři oddělené tajné hodnoty, každá min. 32 náhodných znaků
# (např. `openssl rand -base64 48`). Nikdy je nesdílejte ani neukládejte do repozitáře.
# AUTH_SECRET: HMAC e-mailů a kódů v databázi, šifrování odkazu z e-mailu a rozpracovaného přihlášení.
AUTH_SECRET=
# RATE_LIMIT_SECRET: HMAC klíčů omezení počtu požadavků (v databázi nejsou surové IP, e-maily ani adresy).
RATE_LIMIT_SECRET=
# PIN_PEPPER: pepper PINů (PIN se před argon2id zpracuje HMAC). Rotace vyžaduje plán (docs/security-privacy.md).
PIN_PEPPER=

# AWS SES. Bez těchto proměnných se e-maily (přihlašovací kód) jen vypíšou do konzole a neodešlou.
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
EMAIL_FROM=Se vezmou <info@se-vezmou.cz>

# Jen pro automatické testy (e2e). Nenastavujte lokálně ani na Vercelu; v produkci jsou odmítnuty.
# EMAIL_TRANSPORT=outbox
# EMAIL_OUTBOX_DIR=

# Sentry (DSN z Project Settings → Client Keys; token jen pro nahrávání source map)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
