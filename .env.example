# Zkopíruj do .env.local pro lokální vývoj; na Vercelu nastav v Project Settings.
NEXT_PUBLIC_SITE_URL=https://se-vezmou.cz

# Adresa průvodce (`app.`): sem vedou tlačítka „Vytvořit web“ a pole jmen z úvodní stránky.
# Lokálně např. http://app.localhost:3000. Hodnota se vkládá při sestavení a je i ve `form-action` CSP.
NEXT_PUBLIC_APP_URL=https://app.se-vezmou.cz

# Směrování podle hostitele (docs/adr/0002). Kořenová doména, pod kterou běží app., admin.
# a weby párů. Lokálně `localhost` (běží `localhost:3000`, `app.localhost:3000`,
# `admin.localhost:3000`, `klara-a-matej.localhost:3000`). Na Vercelu v produkci `se-vezmou.cz`
# (výchozí hodnota, když proměnná chybí).
ROOT_DOMAIN=localhost

# Jen pro náhledy nasazení na `*.vercel.app`, které nemají subdomény. Ostrá produkce (`VERCEL_ENV=production`)
# tyto proměnné nikdy nečte. HOST_PRESET: marketing | app | admin | tenant. V produkčním sestavení (náhled
# Vercelu, `NODE_ENV=production`) platí jen `marketing` (dočasně pro úvodní stránku na `*.vercel.app`); `app`
# a `admin` se tam nikdy nepovolí a `tenant` jen s ALLOW_TEST_HATCHES=1. Viz src/lib/test-hatches.ts.
# HOST_PRESET=marketing
# PREVIEW_TENANT_SLUG=klara-a-matej

# Testovací vrátka (src/lib/test-hatches.ts): CRON_TEST_CLOCK, EMAIL_TRANSPORT=outbox, STORAGE_DRIVER=memory,
# ENABLE_UI_CATALOG, OG_FETCH_TEST_HOST a předvolby HOST_PRESET. Ve vývoji (`next dev`, NODE_ENV!=production) fungují
# bez dalšího. V produkčním sestavení nefungují, dokud není nastaveno ALLOW_TEST_HATCHES=1 (jen e2e a CI, viz
# playwright.config.ts); v ostré produkci (`VERCEL_ENV=production`) nefungují nikdy a nastavená vrátka (i samotné
# ALLOW_TEST_HATCHES) server při startu odmítne srozumitelnou chybou. NIKDY nenastavujte na Vercelu.
# ALLOW_TEST_HATCHES=1

# Vizuální katalog UI primitiv na `/ui-catalog`: ve vývoji zapnutý vždy; v produkčním sestavení
# jen s touto proměnnou a ALLOW_TEST_HATCHES=1 (a nikdy při VERCEL_ENV=production). Používá ho test přístupnosti.
# ENABLE_UI_CATALOG=1

# Databáze (docs/adr/0011): sdílený projekt Supabase, aplikace používá VÝHRADNĚ schéma `se_vezmou` a mluví s
# Postgresem přímo přes `pg` (žádný PostgREST, supabase-js, anon ani service role klíč, žádné NEXT_PUBLIC_SUPABASE_*).
# DATABASE_URL: pooler Supabase v transaction módu (port 6543) pro roli se_vezmou_app, jen serverová proměnná na
# Vercelu, např. postgresql://se_vezmou_app.<ref>:<heslo>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Lokálně adresa vlastního PostgreSQL s migracemi (role se_vezmou_app, viz supabase/README.md).
DATABASE_URL=
# PEM kořenové CA Supabase (Dashboard, Database, SSL): u vzdálené databáze POVINNÉ, spojení ověřuje certifikát.
# DATABASE_CA_CERT=
# Vědomé opt-out: TLS bez ověření řetězu pro vzdálenou databázi bez CA (nedoporučeno, jen přechodně).
# DATABASE_TLS_INSECURE=1
# Záložní zdroj adresy: SUPABASE_URL se použije jen pokud začíná postgres:// nebo postgresql://.
# SUPABASE_URL=

# Nasazení migrací (jen pro `npm run db:migrate` na počítači majitele, NIKDY na Vercel ani do repozitáře):
# spojení vlastníka (role postgres), přímé nebo session pooler (port 5432), ne role se_vezmou_app.
# MIGRATE_DATABASE_URL=
# Volitelně PEM kořenové CA Supabase pro `npm run db:migrate` (ověření certifikátu serveru; jen počítač majitele).
# MIGRATE_CA_CERT=

# Přihlášení (M4). Tři oddělené tajné hodnoty, každá min. 32 náhodných znaků
# (např. `openssl rand -base64 48`). Nikdy je nesdílejte ani neukládejte do repozitáře.
# AUTH_SECRET: HMAC e-mailů a kódů v databázi, šifrování odkazu z e-mailu a rozpracovaného přihlášení.
AUTH_SECRET=
# RATE_LIMIT_SECRET: HMAC klíčů omezení počtu požadavků (v databázi nejsou surové IP, e-maily ani adresy).
RATE_LIMIT_SECRET=
# PIN_PEPPER: pepper PINů (PIN se před argon2id zpracuje HMAC). Rotace vyžaduje plán (docs/security-privacy.md).
PIN_PEPPER=

# Provozní administrace (M9, docs/adr/0012). OPERATOR_MFA_KEY: min. 32 náhodných znaků (`openssl rand -base64 48`),
# jiná hodnota než ostatní tajné. Šifruje tajné klíče druhého faktoru (TOTP) operátorů v databázi a odvozuje
# z něj HMAC záložních kódů. Ztráta nebo změna klíče = všichni operátoři si musí znovu zapsat druhý faktor.
OPERATOR_MFA_KEY=

# Plánované úlohy (M10, Vercel Cron): životní cyklus, retence a úklid. Min. 32 náhodných znaků
# (např. `openssl rand -base64 48`). Když je CRON_SECRET nastaven v projektu Vercelu, Vercel ho posílá
# v hlavičce `Authorization: Bearer …` při každém volání cronu; bez něj cesty `/api/cron/*` vrací 401
# a nic se nemaže ani neposílá. Plán je ve `vercel.json` (na tarifu Hobby jen denně, viz docs/data-model.md kap. 17).
CRON_SECRET=

# Jen pro automatické testy (e2e): povolí simulovaný čas (`?now=`) a omezení na jednu svatbu (`?wedding_id=`)
# u cronu. Nenastavujte lokálně ani na Vercelu; v produkčním sestavení bez ALLOW_TEST_HATCHES=1 a v ostré produkci je cron odmítne.
# CRON_TEST_CLOCK=1

# Fotografie páru (M7c, docs/adr/0006-photo-storage.md): Cloudflare R2, jen serverové proměnné. Nový samostatný
# bucket (jurisdikce EU, privátní), API token omezený jen na tento bucket (Object Read & Write); postup, pravidlo
# životního cyklu `incoming/` (1 den) a CORS pro nahrávání jsou v supabase/README.md. Bez těchto proměnných běží
# mimo produkci úložiště v paměti (nahrání i doručení fungují, po restartu serveru fotografie zmizí); v produkci
# bez nich selže teprve použití fotografií (hláška v editoru, chyba s názvy proměnných v logu).
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=se-vezmou-photos
# R2_ENDPOINT=https://<account-id>.eu.r2.cloudflarestorage.com
# S3_REGION=auto
# Jen automatické testy (e2e proti produkčnímu sestavení): `memory` zapne úložiště v paměti i bez R2. Nenastavujte
# lokálně ani na Vercelu; v produkčním sestavení funguje jen s ALLOW_TEST_HATCHES=1, v ostré produkci nikdy.
# STORAGE_DRIVER=memory

# Cloudflare Turnstile (ochrana průvodce a čekací listiny před roboty), widget v dashboardu Cloudflare.
# Jen s oběma klíči je ochrana zapnutá; po změně veřejného klíče nové sestavení (je v CSP i v prohlížeči).
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# AWS SES. Bez těchto proměnných se e-maily neodešlou. Jen při `npm run dev` (NODE_ENV=development) se jejich obsah
# (přihlašovací kód) vypíše do konzole; v produkčním sestavení se bez SES nic neodešle a obsah se nikdy nevypisuje.
# Na Vercelu v produkci jsou povinné (jinak nedorazí kódy).
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
EMAIL_FROM=Se vezmou <info@se-vezmou.cz>
# Nepovinné: konfigurační sada SES (události doručení přes SNS), viz docs/launch-checklist.md kap. 10.
SES_CONFIGURATION_SET=

# Jen pro automatické testy (e2e). Nenastavujte lokálně ani na Vercelu; v produkčním sestavení vyžadují
# ALLOW_TEST_HATCHES=1, v ostré produkci jsou odmítnuty. Bez AWS_* a EMAIL_FROM v produkčním sestavení odeslání
# e-mailu selže (konzolová doprava je jen pro vývoj), takže nikdy nevznikne záznam „odesláno“ bez doručení.
# EMAIL_TRANSPORT=outbox
# EMAIL_OUTBOX_DIR=

# Jen pro e2e test načtení náhledu externí galerie (src/admin/site/og.ts): `jmeno=127.0.0.1:port` spojí jedno jméno
# hostitele bez DNS a TLS s loopbackem. NIKDY ne lokálně pro běžný vývoj ani na Vercelu (docs/security-privacy.md kap. 12).
# OG_FETCH_TEST_HOST=

# Proměnné nastavuje platforma nebo je čtou jen skripty testů; sami je v `.env.local` nenastavujte:
# NODE_ENV, VERCEL, VERCEL_ENV, CI, NEXT_RUNTIME (Next.js, Vercel a CI);
# E2E_PORT, E2E_OG_PORT, E2E_REUSE_SERVER, E2E_OUTBOX_DIR, E2E_DATABASE_URL, E2E_APP_DATABASE_URL,
# PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH (Playwright a scripts/e2e-db.sh, viz README).

# Sentry (DSN z Project Settings → Client Keys; token jen pro nahrávání source map). Bez DSN se nic neodesílá.
# Události se čistí (src/lib/sentry-scrub.ts) a v prohlížeči běží Sentry jen na úvodní stránce, ne u hostů (ADR 0007).
# Zapnutí je rozhodnutí majitele (OQ-65): zpracovatel, EU region, smlouva o zpracování.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
