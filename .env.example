# Zkopíruj do .env.local pro lokální vývoj; na Vercelu nastav v Project Settings.
NEXT_PUBLIC_SITE_URL=https://se-vezmou.cz

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AWS SES
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
EMAIL_FROM=Se vezmou <info@se-vezmou.cz>

# Administrace (Google login přes Supabase Auth), e-maily oddělené čárkou
ADMIN_EMAILS=

# Sentry (DSN z Project Settings → Client Keys; token jen pro nahrávání source map)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
