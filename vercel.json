{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "ignoreCommand": "[ \"$VERCEL_GIT_COMMIT_REF\" = \"main\" ] && exit 1 || exit 0",
  "crons": [
    {
      "path": "/api/cron/daily",
      "schedule": "17 3 * * *"
    },
    {
      "path": "/api/cron/blog",
      "schedule": "1 22 * * *"
    },
    {
      "path": "/api/cron/blog",
      "schedule": "1 23 * * *"
    }
  ]
}
